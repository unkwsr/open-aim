{
  "name": "aim-trainer",
  "productName": "openVaim",
  "version": "1.4.3",
  "description": "Offline desktop version of the open-aim trainer",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prestart": "node ../scripts/build-scenarios.mjs",
    "start": "electron .",
    "prebuild": "node ../scripts/build-scenarios.mjs",
    "build": "electron-builder --win portable nsis",
    "check": "node ../scripts/build-scenarios.mjs --check"
  },
  "build": {
    "appId": "local.aimtrainer.offline",
    "productName": "openVaim",
    "directories": {
      "output": "dist"
    },
    "extraMetadata": {
      "main": "worker-test-main.cjs"
    },
    "files": [
      "*.js",
      "*.cjs",
      "*.mjs",
      "*.css",
      "training-set.json",
      "package.json",
      "studio/**/*",
      "i18n/**/*",
      "build/icon.ico",
      "!worker-trace-main.cjs",
      "!*.bak*",
      "!**/*.bak*",
      "!test-maps.mjs"
    ],
    "extraResources": [
      {
        "from": "../base",
        "to": "base"
      },
      {
        "from": "../site_meta.json",
        "to": "site_meta.json"
      },
      {
        "from": "site",
        "to": "site",
        "filter": [
          "**/*",
          "!**/source.json"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "openVaim.exe"
    },
    "nsis": {
      "artifactName": "openVaim-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "openVaim",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  }
}
